# Copy to .env. Read by systemd via EnvironmentFile=, so this is not a shell
# script: no quoting, no expansion, and values are taken literally to end of
# line. A Gmail app password with spaces in it works unquoted.
#
# .env is gitignored. Never put a real secret in this file.

# --- mailbox ---
IMAP_USER=you@example.com
IMAP_APP_PASSWORD=abcd efgh ijkl mnop
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com

# --- telegram ---
TELEGRAM_BOT_TOKEN=000000000:replace-me
# Leave unset on first run: `ronny bot` then answers only /start, with your own
# chat id, and refuses everything else until this is filled in.
TELEGRAM_OWNER_CHAT_ID=

# --- models ---
# Everything that reads message bodies runs here, on this machine.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5
# Only chat commands go to TypeSafe -- never mail content. Leave the key empty
# to fall back to the local classifier; nothing else changes.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# --- voice ---
# Unset disables voice notes. The medium model is ~1.5GB and takes ~30s to
# load, which is why it is loaded once and kept resident.
WHISPER_MODEL_PATH=models/ggml-medium.bin

# --- state ---
RONNY_SENDERS_FILE=config/senders.yaml
RONNY_STATE_FILE=data/state.json
RONNY_CONTROLLER_STATE_FILE=data/controller_state.json

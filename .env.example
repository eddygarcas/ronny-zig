# Copy to .env. Read by systemd via EnvironmentFile=, so this is not a shell
# script: no quoting, no expansion, and values are taken literally to end of
# line. A Gmail app password with spaces in it works unquoted.
#
# .env is gitignored. Never put a real secret in this file.

# --- mailbox ---
IMAP_USER=you@example.com
IMAP_APP_PASSWORD=abcd efgh ijkl mnop
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com

# --- telegram ---
TELEGRAM_BOT_TOKEN=000000000:replace-me
# Leave unset on first run: `ronny bot` then answers only /start, with your own
# chat id, and refuses everything else until this is filled in.
TELEGRAM_OWNER_CHAT_ID=

# --- models ---
# Everything that reads message bodies runs here, on this machine.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5
# Chat commands go to TypeSafe so it can pick the action. Leave the key empty
# to fall back to the local classifier; nothing else changes.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Lets Jev rank content-search results. This is the ONLY setting that sends
# message text off this machine -- everything else keeps bodies on local
# Ollama. Ranking is where the local model is weakest and where a wrong
# answer is silent, so it buys real quality; it is off by default because
# it is a decision about your mailbox, not one to inherit.
TYPESAFE_RANK_MAIL=false

# --- voice ---
# Unset disables voice notes. The medium model is ~1.5GB and takes ~30s to
# load, which is why it is loaded once and kept resident.
WHISPER_MODEL_PATH=models/ggml-medium.bin

# Languages you actually speak. Auto-detect stays on -- switch mid-sentence
# if you like -- but anything outside this list is decoded again rather than
# trusted. Leave empty to accept whatever whisper reports.
WHISPER_LANGUAGES=en,es

# A *spoken* yes will not approve a drafted email unless this is true. Typing
# is unambiguous; a misheard word would send mail you declined. This one lives
# here rather than in the chat settings on purpose -- a safety property a chat
# message can switch off is not a safety property.
VOICE_CAN_CONFIRM_SEND=false

# --- voice summaries ---
# Unset keeps every summary as text. Set, it lets the owner switch summaries
# to voice messages from chat ("send summaries as voice messages"); the
# choice is saved in the settings file and falls back to text whenever this
# is missing, so it can never lose a summary. Piper is a local text-to-speech
# engine, installed with `pip install piper-tts` into a venv:
#   python3 -m venv ~/.local/opt/piper && ~/.local/opt/piper/bin/pip install piper-tts
# and voices downloaded into PIPER_VOICES_DIR with
#   cd ~/.local/opt/piper/voices && ../bin/python -m piper.download_voices en_US-hfc_male-medium es_ES-davefx-medium
# Source: https://github.com/OHF-Voice/piper1-gpl/blob/main/docs/CLI.md
PIPER_BIN=/home/you/.local/opt/piper/bin/piper
# Defaults to <venv>/voices when unset.
PIPER_VOICES_DIR=/home/you/.local/opt/piper/voices
# The default voice per language. Every <name>.onnx in PIPER_VOICES_DIR can
# be chosen from chat instead ("use john's voice"); these are what reads
# until the owner does. Samples: https://rhasspy.github.io/piper-samples
PIPER_VOICE_EN=en_US-hfc_male-medium
PIPER_VOICE_ES=es_ES-davefx-medium

# --- state ---
RONNY_SENDERS_FILE=config/senders.yaml
RONNY_STATE_FILE=data/state.json
RONNY_CONTROLLER_STATE_FILE=data/controller_state.json
# Quiet hours and the default look-back, changed from chat rather than here.
# Written by `ronny bot`, read by both processes. See /settings.
RONNY_SETTINGS_FILE=data/settings.json
